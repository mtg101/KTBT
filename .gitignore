# Godot 4+ specific ignores
.godot/
/android/

# OS clutter
Thumbs.db
.DS_Store

# Personal editor settings (contain machine-specific paths)
.vscode/

# GdUnit4 test reports (generated on every run)
/reports/

# GdUnit4 rewrites this on every test run (it remembers the last run)
/addons/gdUnit4/GdUnitRunner.cfg

# Night transcripts, written when playing from the editor
/logs/

# This PC's own path to Godot, for tools/autoplay.bat
/tools/godot_path.txt

# The image model's raw pictures, before the pixelate tool (each kept art's source is in art/manifest.json)
/art/raw/
# This PC's own path to ComfyUI, for the helper's art tools
/tools/comfyui_path.txt

# Python caches (tools/art)
__pycache__/
