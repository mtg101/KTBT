# Godot 4+ specific ignores
.godot/
/android/

# OS clutter
Thumbs.db
.DS_Store

# Personal editor settings (contain machine-specific paths)
.vscode/

# GdUnit4 test reports (generated on every run)
/reports/

# GdUnit4 rewrites this on every test run (it remembers the last run)
/addons/gdUnit4/GdUnitRunner.cfg

# Night transcripts, written when playing from the editor
/logs/
